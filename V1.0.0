//====================================================
// DEBUG TABLE
//====================================================

var table debugTable = table.new(position.top_right, 2, 13, border_width=1)

if barstate.islast
    table.cell(debugTable, 0, 0, "Condition", bgcolor=color.black, text_color=color.white)
    table.cell(debugTable, 1, 0, "Status", bgcolor=color.black, text_color=color.white)

    table.cell(debugTable, 0, 1, "Trend")
    table.cell(debugTable, 1, 1, trendStrong ? "✅" : "❌", text_color=trendStrong ? color.lime : color.red)

    table.cell(debugTable, 0, 2, "ATR")
    table.cell(debugTable, 1, 2, volatilityGood ? "✅" : "❌", text_color=volatilityGood ? color.lime : color.red)

    table.cell(debugTable, 0, 3, "Session")
    table.cell(debugTable, 1, 3, sessionActive ? "✅" : "❌", text_color=sessionActive ? color.lime : color.red)

    table.cell(debugTable, 0, 4, "Pullback")
    table.cell(debugTable, 1, 4, pullbackValid ? "✅" : "❌", text_color=pullbackValid ? color.lime : color.red)

    table.cell(debugTable, 0, 5, "Structure")
    table.cell(debugTable, 1, 5, bullishStructure ? "✅" : "❌", text_color=bullishStructure ? color.lime : color.red)

    table.cell(debugTable, 0, 6, "BOS")
    table.cell(debugTable, 1, 6, bullishBOS ? "✅" : "❌", text_color=bullishBOS ? color.lime : color.red)

    table.cell(debugTable, 0, 7, "Order Block")
    table.cell(debugTable, 1, 7, bullishOrderBlock ? "✅" : "❌", text_color=bullishOrderBlock ? color.lime : color.red)

    table.cell(debugTable, 0, 8, "FVG")
    table.cell(debugTable, 1, 8, bullishFVG ? "✅" : "❌", text_color=bullishFVG ? color.lime : color.red)

    table.cell(debugTable, 0, 9, "Liquidity")
    table.cell(debugTable, 1, 9, bullishLiquiditySweep ? "✅" : "❌", text_color=bullishLiquiditySweep ? color.lime : color.red)

    table.cell(debugTable, 0, 10, "RSI")
    table.cell(debugTable, 1, 10, bullishMomentum ? "✅" : "❌", text_color=bullishMomentum ? color.lime : color.red)

    table.cell(debugTable, 0, 11, "AI")
    table.cell(debugTable, 1, 11, buyApproved ? "✅" : "❌", text_color=buyApproved ? color.lime : color.red)

    table.cell(debugTable, 0, 12, "BUY SETUP")
    table.cell(debugTable, 1, 12, buySetup ? "🚀" : "❌", text_color=buySetup ? color.lime : color.red)
