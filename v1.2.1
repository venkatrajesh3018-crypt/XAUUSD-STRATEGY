    color = color.red,
    size = size.tiny
)

//====================================================
// MODULE 5.9 - BREAK OF STRUCTURE
//====================================================
// Bullish Break of Structure
bullishBOS = not na(previousPivotHigh) and close > previousPivotHigh

// Bearish Break of Structure
bearishBOS = not na(previousPivotLow) and close < previousPivotLow

plotshape(
    showDebug and bullishBOS,
    title="Bullish BOS",
    style=shape.labelup,
    location=location.belowbar,
    color=color.green,
    text="BOS",
    textcolor=color.white,
    size=size.tiny
)

