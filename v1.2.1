//====================================================
// MODULE 5.7 - ORDER BLOCK ENGINE
//====================================================
// Bullish Order Block
bullishOrderBlock =
     low == ta.lowest(low, orderBlockLookback)

// Bearish Order Block
bearishOrderBlock =
     high == ta.highest(high, orderBlockLookback)

plotshape(
     showDebug and bullishOrderBlock,
