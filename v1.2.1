    title="SELL Signal",
    style=shape.arrowdown,
    location=location.abovebar,
    color=color.red,
    size=size.small,
    text="SELL"
)

// Exit the BUY trade
strategy.exit(
    "Long Exit",
    from_entry = "Long",
    stop = longStop,
    limit = buyTakeProfit
)
// Exit the sell trade
strategy.exit(
     "Short Exit",
     from_entry = "Short",
     stop = shortStop,
     limit = sellTakeProfit
)

inLongTrade :=
     strategy.position_size > 0

inShortTrade :=
     strategy.position_size < 0
